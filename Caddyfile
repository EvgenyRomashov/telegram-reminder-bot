{$WEB_DOMAIN} {
    encode zstd gzip
    reverse_proxy web:8000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; connect-src 'self'; img-src 'self' data: https:; frame-ancestors https://web.telegram.org https://webk.telegram.org https://webz.telegram.org"
    }
}

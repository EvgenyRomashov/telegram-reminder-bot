# Telegram Bot Token
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Database URL
# For SQLite, it's just the path to the file.
DATABASE_URL="sqlite:////app/data/reminders.db"

# Public HTTPS URL of the Telegram Mini App
# Leave empty until DNS and TLS are configured.
WEB_APP_URL=""
WEB_DOMAIN=""

# Maximum accepted age of Telegram initData, in seconds
MINI_APP_AUTH_MAX_AGE="86400"
